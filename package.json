{
  "name": "hiremax-ai---resume-optimizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite apps/web --config apps/web/vite.config.ts",
    "build": "vite build apps/web --config apps/web/vite.config.ts",
    "preview": "vite preview",
    "preflight": "npx tsx preflight/validateAdapters.ts && npx tsx preflight/validateSources.ts",
    "preflight:adapters": "npx tsx preflight/validateAdapters.ts",
    "preflight:sources": "npx tsx preflight/validateSources.ts",
    "simulate": "npx tsx preflight/simulateIngestion.ts",
    "pulse": "npx tsx confirm/dbPulse.ts",
    "pulse:30": "npx tsx confirm/dbPulse.ts 30",
    "3c": "npx tsx preflight/validateAdapters.ts && npx tsx preflight/validateSources.ts && npx tsx confirm/dbPulse.ts",
    "coverage": "npx tsx coverage/detectAnomalies.ts",
    "deploy": "wrangler deploy",
    "deploy:web": "npm run build && npx vercel deploy --prod",
    "production-gate": "npm run build && npx tsx scripts/production-readiness.ts",
    "probe:functions": "npx tsx scripts/probe-edge-functions.ts"
  },
  "dependencies": {
    "@google/genai": "1.34.0",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^2.0.1",
    "aws4fetch": "^1.0.20",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "0.469.0",
    "mammoth": "1.6.0",
    "pdfjs-dist": "4.4.168",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "supabase": "^2.75.5",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "wrangler": "^4.85.0"
  }
}
